<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net7.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <Title>IOLab</Title>
    <ApplicationIcon>Resources\Images\Icon\Favicon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\Font\Blender Pro Bold.ttf" />
    <None Remove="Resources\Font\Blender Pro Book.ttf" />
    <None Remove="Resources\Font\MiSans VF.ttf" />
    <None Remove="Resources\Images\Icon\IOLab1024.png" />
    <None Remove="Resources\Images\Icon\IOLab128.png" />
    <None Remove="Resources\Images\Icon\IOLab256.png" />
    <None Remove="Resources\Images\Icon\IOLab512.png" />
    <None Remove="Resources\Images\Mareix.jpg" />
    <None Remove="Resources\Images\Microsoft.png" />
    <None Remove="Resources\Images\Redmaple.jpg" />
    <None Remove="Resources\Images\Tiny\ShallowShadow.png" />
    <None Remove="Resources\Images\Tiny\ShallowShadowDark.png" />
    <None Remove="Resources\Images\YeJianFeng.jpg" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\Images\Icon\Favicon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Font\Blender Pro Bold.ttf" />
    <Resource Include="Resources\Font\Blender Pro Book.ttf" />
    <Resource Include="Resources\Images\Tiny\ShallowShadow.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Font\MiSans VF.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\Images\Icon\IOLab1024.png" />
    <Resource Include="Resources\Images\Icon\IOLab128.png" />
    <Resource Include="Resources\Images\Icon\IOLab256.png" />
    <Resource Include="Resources\Images\Icon\IOLab512.png" />
    <Resource Include="Resources\Images\Mareix.jpg">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\Images\Microsoft.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\Images\Redmaple.jpg">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\Images\Tiny\ShallowShadowDark.png" />
    <Resource Include="Resources\Images\YeJianFeng.jpg" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="iNKORE.UI.WPF" Version="1.2.7.1" />
    <PackageReference Include="iNKORE.UI.WPF.Modern" Version="0.9.30" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.0-rc2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
    <Compile Update="Resources\Control\Cyber\InfoBar.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Windows\Dialog\AddChart.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Windows\Dialog\RFIDConfig.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Windows\Dialog\QuoteOSP.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Windows\Dialog\SaveRecords.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Windows\Dialog\Universal\ExperimentDialog.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Windows\Dialog\Universal\OpenWebLink.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Windows\Dialog\LearnMoreAboutDeveloper.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Windows\Dialog\ConnectCommunity.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Windows\Dialog\PortDefine.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Resources\Images\DoubleImages\" />
    <Folder Include="Resources\Video\" />
    <Folder Include="Util\Files\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IOLab.Core\IOLab.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

</Project>
