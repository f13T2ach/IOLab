<UserControl x:Class="IOLab.Resources.Control.ExperimentAssistance"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IOLab.Resources.Control"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern" xmlns:viewmodel="clr-namespace:IOLab.Resources.Control.ViewModel" d:DataContext="{d:DesignInstance Type=viewmodel:ExperimentAssistanceViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="250" d:DesignWidth="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5*"/>
        </Grid.RowDefinitions>
        <ui:AcrylicPanel Grid.Row="0" CornerRadius="5">
            <Grid>
                <TextBlock FontSize="15" Margin="8,5,5,5" Text="{Binding ExperimentName}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <StackPanel Margin="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="解除" Margin="2" Command="{Binding ReleaseExperimentButtonClicked}" CommandParameter="{Binding}" Style="{StaticResource {x:Static ui:ThemeKeys.AccentButtonStyleKey}}"/>
                    <Button Content="..." Margin="2"/>
                </StackPanel>
                
            </Grid>
        </ui:AcrylicPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*"/>
                <ColumnDefinition Width="5*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <ScrollViewer>
                <StackPanel Margin="5" Orientation="Vertical" VerticalAlignment="Center">
                    
                    <TextBlock FontSize="20" Margin="5" Text="{Binding StepName}" FontWeight="Bold"/>
                    <TextBlock FontSize="15" Margin="5" Text="{Binding StepDescription}" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding AbsolveStepVisibility}">
                        <ui:FontIcon Margin="2" Icon="{x:Static ui:SegoeFluentIcons.Info}" FontSize="13" Foreground="{StaticResource {x:Static ui:ThemeKeys.AccentTextFillColorPrimaryBrushKey}}"/>
                        <TextBlock Margin="0,2,0,2" Text="非最新步骤，此修改不会被检查" TextWrapping="Wrap" Foreground="{StaticResource {x:Static ui:ThemeKeys.AccentTextFillColorPrimaryBrushKey}}"/>
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="4*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Separator HorizontalAlignment="Right" Grid.Row="1">
                        <Separator.LayoutTransform>
                            <RotateTransform Angle="90" />
                        </Separator.LayoutTransform>
                    </Separator>
                </Grid>
                

            </Grid>

            <Grid Grid.Column="1">
                <Grid Margin="5">
                    
                    <StackPanel VerticalAlignment="Top" Margin="5" Orientation="Vertical">
                        <TextBlock FontSize="18" Text="还剩 0 个表"/>
                        <TextBlock FontSize="13" Text=""/>
                    </StackPanel>
                    <StackPanel Margin="0,15,0,0" VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Vertical">
                        <Button Command="{Binding PreviousStepButtonClicked}" HorizontalAlignment="Center" Margin="2" Style="{StaticResource {x:Static ui:ThemeKeys.AccentButtonStyleKey}}">
                            <Button.Content>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Up}"/>
                            </Button.Content>
                        </Button>
                        <Button Command="{Binding NextStepButtonClicked}" HorizontalAlignment="Center" Margin="2" IsEnabled="{Binding EnableForNextStep}" Style="{StaticResource {x:Static ui:ThemeKeys.AccentButtonStyleKey}}">
                            <Button.Content>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Down}"/>
                            </Button.Content>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
                
        </Grid>
        
    </Grid>
</UserControl>
