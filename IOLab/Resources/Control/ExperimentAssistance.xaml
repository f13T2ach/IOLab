<UserControl x:Class="IOLab.Resources.Control.ExperimentAssistance"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IOLab.Resources.Control"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             mc:Ignorable="d" 
             d:DesignHeight="250" d:DesignWidth="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5*"/>
        </Grid.RowDefinitions>
        <ui:AcrylicPanel Grid.Row="0" CornerRadius="5">
            <Grid>
                <TextBlock FontSize="15" Margin="8,5,5,5" Text="实验助手" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <StackPanel Margin="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="解除" Margin="2" Style="{StaticResource {x:Static ui:ThemeKeys.AccentButtonStyleKey}}"/>
                    <Button Content="反馈" Margin="2"/>
                </StackPanel>
                
            </Grid>
        </ui:AcrylicPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*"/>
                <ColumnDefinition Width="5*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <StackPanel Margin="5" Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock FontSize="20" Margin="5" Text="无步骤" FontWeight="Bold"/>
                    <TextBlock FontSize="15" Margin="5" Text="你正在自由实验，实践一个实验后实验助手便帮助你实验" TextWrapping="Wrap"/>
                </StackPanel>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="4*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Separator HorizontalAlignment="Right" Grid.Row="1">
                        <Separator.LayoutTransform>
                            <RotateTransform Angle="90" />
                        </Separator.LayoutTransform>
                    </Separator>
                </Grid>
                

            </Grid>

            <Grid Grid.Column="1">
                <Grid Margin="5">
                    <TextBlock Text="Assistance 1.0" VerticalAlignment="Bottom" HorizontalAlignment="Right" Opacity="0.6"/>
                    <StackPanel VerticalAlignment="Top" Margin="5" Orientation="Vertical">
                        <TextBlock FontSize="18" Text="还剩 0 个表"/>
                        <TextBlock FontSize="13" Text=""/>
                    </StackPanel>
                    <StackPanel Margin="0,15,0,0" VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Vertical">
                        <Button HorizontalAlignment="Center" Margin="2" Style="{StaticResource {x:Static ui:ThemeKeys.AccentButtonStyleKey}}">
                            <Button.Content>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Up}"/>
                            </Button.Content>
                        </Button>
                        <Button HorizontalAlignment="Center" Content="检查是否已完成" Margin="2" Style="{StaticResource {x:Static ui:ThemeKeys.AccentButtonStyleKey}}"/>
                        <Button HorizontalAlignment="Center" Margin="2" Style="{StaticResource {x:Static ui:ThemeKeys.AccentButtonStyleKey}}">
                            <Button.Content>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Down}"/>
                            </Button.Content>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
                
        </Grid>
        
    </Grid>
</UserControl>
