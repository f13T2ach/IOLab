<UserControl x:Class="IOLab.Resources.Control.RecordDetail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             xmlns:local="clr-namespace:IOLab.Resources.Control"
             mc:Ignorable="d" 
             >
    <Border VerticalAlignment="Top" Style="{StaticResource Style_SectionBorderStyle}" Height="72" Margin="4">
        <Grid VerticalAlignment="Center" Margin="0,10,0,10">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Cafe}" Grid.RowSpan="2" Margin="5,15,20,15"/>
            <TextBlock FontSize="15" x:Name="TextBlock_StylusToDraw" Text="实验记录_高锰酸钾制氧气_20240101_1723555251" Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
            <TextBlock FontSize="13" x:Name="TextBlock_StylusToDraw_Description" Text="于 2024/01/01 检测了 O2浓度 等共 1 项指标" Grid.Column="1" VerticalAlignment="Top" Grid.Row="1" Margin="0,2,20,5" Opacity="0.615" TextTrimming="CharacterEllipsis" TextWrapping="WrapWithOverflow"/>
            <StackPanel Orientation="Horizontal" Grid.Column="2" Grid.RowSpan="2">
                <Button Content="修改" Margin="2" x:Name="TestButton"  Width="80" Height="32"/>
                <Button Content="导出" Style="{StaticResource {x:Static ui:ThemeKeys.AccentButtonStyleKey}}" Margin="2" x:Name="TestButton2"  Width="80" Height="32"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
