<UserControl x:Class="IOLab.Resources.Control.ExperimentDetail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             xmlns:local="clr-namespace:IOLab.Resources.Control"
             mc:Ignorable="d" 
             >
    <Border VerticalAlignment="Top" Style="{StaticResource Style_SectionBorderStyle}" Height="72" Margin="4">
        <Grid VerticalAlignment="Center" Margin="0,10,0,10">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Caption}" Grid.RowSpan="2" Margin="5,15,20,15"/>
            <TextBlock FontSize="15" x:Name="TextBlock_StylusToDraw2" Text="{Binding RealName}" Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
            <TextBlock FontSize="13" x:Name="TextBlock_StylusToDraw_Description2" Text="{Binding Description}" Grid.Column="1" VerticalAlignment="Top" Grid.Row="1" Margin="0,2,20,5" Opacity="0.615" TextTrimming="CharacterEllipsis" TextWrapping="WrapWithOverflow"/>
            <StackPanel Orientation="Horizontal" Grid.Column="2" Grid.RowSpan="2">
                <Button Content="实践" Margin="2" x:Name="TestButton3"  Width="80" Height="32"/>
                <Button Content="详情" Style="{StaticResource {x:Static ui:ThemeKeys.AccentButtonStyleKey}}" Margin="2" x:Name="TestButton4"  Width="80" Height="32"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
