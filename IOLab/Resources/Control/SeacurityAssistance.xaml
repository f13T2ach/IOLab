<UserControl x:Class="IOLab.Resources.Control.SeacurityAssistance"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IOLab.Resources.Control"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern" xmlns:viewmodel="clr-namespace:IOLab.Resources.Control.ViewModel" d:DataContext="{d:DesignInstance Type=viewmodel:ExperimentAssistanceViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="250" d:DesignWidth="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5*"/>
        </Grid.RowDefinitions>
        <ui:AcrylicPanel Grid.Row="0" CornerRadius="5">
            <Grid>
                <TextBlock FontSize="15" Margin="8,5,5,5" Text="{Binding ExperimentName}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <StackPanel Margin="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="复位" Margin="2" Command="{Binding ReleaseExperimentButtonClicked}" CommandParameter="{Binding}" Style="{StaticResource {x:Static ui:ThemeKeys.AccentButtonStyleKey}}"/>
                    <Button Content="配置传感器" Margin="2"/>
                </StackPanel>
                
            </Grid>
        </ui:AcrylicPanel>
        <Grid Grid.Row="1">
            <Grid Grid.Column="0">
                <ScrollViewer>
                <StackPanel Margin="5" Orientation="Vertical" VerticalAlignment="Center">

                        <TextBlock FontSize="50" Margin="5,-10,5,5" Text="安全" HorizontalAlignment="Center"  FontWeight="Bold"  Foreground="{StaticResource {x:Static ui:ThemeKeys.AccentTextFillColorPrimaryBrushKey}}"/>
                    <TextBlock FontSize="15" Margin="5" Text="一共 10 个布尔传感器，0 个检出危险数据" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding AbsolveStepVisibility}">
                        <ui:FontIcon Margin="2" Icon="{x:Static ui:SegoeFluentIcons.Info}" FontSize="13" Foreground="{StaticResource {x:Static ui:ThemeKeys.AccentTextFillColorPrimaryBrushKey}}"/>
                        <TextBlock Margin="0,2,0,2" Text="IOLab 不对因数据误差导致的危险负责" TextWrapping="Wrap" Foreground="{StaticResource {x:Static ui:ThemeKeys.AccentTextFillColorPrimaryBrushKey}}"/>
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="4*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                </Grid>
                

            </Grid>


        </Grid>
        
    </Grid>
</UserControl>
