<UserControl x:Class="IOLab.Resources.Control.BetterButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Button Height="30" Width="150" Background="Transparent" BorderBrush="Black" BorderThickness="1">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Content" Value="My Button"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <!-- 背景矩形 -->
                                    <Rectangle x:Name="backgroundRect" Fill="{TemplateBinding Background}" />

                                    <!-- 创建镂空效果 -->
                                    <Rectangle x:Name="maskRect" Fill="{TemplateBinding Foreground}" Visibility="Collapsed">
                                        <Rectangle.OpacityMask>
                                            <VisualBrush Visual="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content}" />
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="backgroundRect" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="maskRect" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</UserControl>