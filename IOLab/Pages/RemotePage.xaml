<ui:Page x:Class="IOLab.Pages.RemotePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:IOLab.Pages"
      xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="1280"
      Title="管理">

    <Grid Margin="20,20,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontStyle="Italic" Opacity="0.84" Text="采集器仪表盘" FontSize="24" FontWeight="Bold" Width="150"/>
                <TextBlock Text="{Binding CurrentTime}" Opacity="0.7" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontStyle="Italic" FontSize="14" Width="70"></TextBlock>
            </StackPanel>

            <Separator Grid.Column="1" Margin="10,0,10,0"/>
            <TextBlock Grid.Column="2" Opacity="0.7" Text="IOLab.Core.Serial" Margin="4" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" FontWeight="Medium"/>
            <Grid Grid.Column="3" Height="20">

                <TextBlock Opacity="0.7" Text="IOLAB" Margin="0,0,0,4" VerticalAlignment="Bottom" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" FontStyle="Italic"/>
                <TextBlock Opacity="0.5" Text="IOLAB" Margin="0,4,0,0" VerticalAlignment="Top" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" FontStyle="Italic"/>
            </Grid>
        </Grid>

        <!--
            <TextBlock x:Name="Header" Text="Name" FontSize="24" FontWeight="Bold" Margin="0,0,0,10"/>
            <Button Content="重命名设备" Click="Rename_Click"/>
            -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Image x:Name="ShallowShadow" Width="14" VerticalAlignment="Bottom"/>
            </Grid>
            <Grid Grid.Column="2">
                <TextBlock Margin="0,10,0,0" Text="COLLECTOR 监控" VerticalAlignment="Top" FontStyle="Italic" Opacity="0.7"  FontSize="24" FontWeight="Bold">
                    <TextBlock.LayoutTransform>
                        <RotateTransform Angle="90"></RotateTransform>
                    </TextBlock.LayoutTransform>
                </TextBlock>

                <TextBlock Margin="0,0,0,0" Text="▲" VerticalAlignment="Bottom" Opacity="0.7"  FontSize="28" FontWeight="Bold"/>
            </Grid>
        </Grid>
        <ui:Frame Grid.Row="3" x:Name="ViewField"/>

    </Grid>
</ui:Page>