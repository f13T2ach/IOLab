<ui:Page x:Class="IOLab.Pages.MonitorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ct="clr-namespace:IOLab.Resources.Control"
         xmlns:custom="clr-namespace:IOLab.Resources.Control.Custom"
      xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern" xmlns:local1="clr-namespace:IOLab.Resources.Control" xmlns:viewmodel="clr-namespace:IOLab.Pages.ViewModel" d:DataContext="{d:DesignInstance Type=viewmodel:MonitorPageViewModel}"
      mc:Ignorable="d" 
         xmlns:windows="clr-namespace:IOLab.Windows"
      d:DesignHeight="720" d:DesignWidth="1280"
         Unloaded="Page_Unloaded"
      >
    <Page.Resources>

    </Page.Resources>
    <Grid Margin="0,40,0,0">
        
        
        <ui:AcrylicPanel CornerRadius="4" VerticalAlignment="Top" >
            <ui:CommandBar Height="48">
                <ui:AppBarButton IsCompact="True" ToolTipService.ToolTip="Sort">
                    <ui:AppBarButton.Icon>
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Trackers}"/>
                    </ui:AppBarButton.Icon>
                    <ui:AppBarButton.Label>
                        <TextBlock Text="实验"/>
                    </ui:AppBarButton.Label>
                    
                    <ui:AppBarButton.Flyout>
                        <ui:Flyout>
                            <Grid Width="400" Height="250">
                                <ct:ExperimentAssistance/>
                            </Grid>
                        </ui:Flyout>
                        </ui:AppBarButton.Flyout>
                </ui:AppBarButton>
                <ui:AppBarButton IsCompact="True" ToolTipService.ToolTip="Sort">
                    <ui:AppBarButton.Icon>
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Health}"/>
                    </ui:AppBarButton.Icon>
                    <ui:AppBarButton.Label>
                        <TextBlock Text="安全"/>
                    </ui:AppBarButton.Label>

                    <ui:AppBarButton.Flyout>
                        <ui:Flyout>
                            <Grid Width="400" Height="250">
                                <ct:SeacurityAssistance/>
                            </Grid>
                        </ui:Flyout>
                    </ui:AppBarButton.Flyout>
                </ui:AppBarButton>
                <ui:AppBarToggleButton Label="暂停" IsChecked="{Binding IsPauseRecord}">
                    <ui:AppBarToggleButton.Icon>
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Pause}"/>
                    </ui:AppBarToggleButton.Icon>
                </ui:AppBarToggleButton>
                <ui:AppBarSeparator/>
                <ui:AppBarButton Label="详情" >
                    <ui:AppBarButton.Icon>
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Info}"/>
                    </ui:AppBarButton.Icon>
                </ui:AppBarButton>
                <ui:AppBarButton Label="简化" >
                    <ui:AppBarButton.Icon>
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.LightningBolt}"/>
                    </ui:AppBarButton.Icon>
                </ui:AppBarButton>
                <ui:AppBarSeparator/>
                <ui:AppBarButton Label="帮助" >
                    <ui:AppBarButton.Icon>
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Help}"/>
                    </ui:AppBarButton.Icon>
                </ui:AppBarButton>
                <ui:CommandBar.Content>
                    <TextBlock Text="未命名实验" Margin="12,14"/>
                </ui:CommandBar.Content>

            </ui:CommandBar>
        </ui:AcrylicPanel>
        <Button IsEnabled="{Binding ManageButtonEnable}" VerticalAlignment="Top" Cursor="Hand" x:Name="ManagePins" Click="ManagePins_Click" Style="{StaticResource {x:Static ui:ThemeKeys.AccentButtonStyleKey}}" HorizontalAlignment="Center" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal">
                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Wire}"/>
                <TextBlock Text="{Binding DeviceNameText}" Margin="5,0,0,0"/>
            </StackPanel>

        </Button>
        <Button Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,8,0,0" Background="Red">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="警告" FontWeight="Bold"/>
                <TextBlock Text="性能开销过大，请简化图表" Margin="5,0,0,0"/>
            </StackPanel>

        </Button>
        <Grid Margin="0,64,0,48">
            <!--
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock TextAlignment="Center" FontSize="16" Text="创建一个表以开始实验"/>
                <TextBlock TextAlignment="Center" FontSize="16" Text="或"/>
                <Button x:Name="GotoCompareMode" HorizontalAlignment="Center" Cursor="Hand" IsEnabled="True" Style="{StaticResource {x:Static ui:ThemeKeys.AccentButtonStyleKey}}" Margin="0,4,0,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="进入对照实验模式（Beta）"/>
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.ArrowRight8}"/>
                    </StackPanel>
                </Button>
                <TextBlock Opacity="0.6" TextAlignment="Center" Text="对照实验模式是实验性功能，可能有影响体验的问题"/>
            </StackPanel>
            -->
            <ItemsControl ItemsSource="{Binding MappedChartTables}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ct:ChartModule/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <custom:EqualAreaPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

        </Grid>
        <Grid VerticalAlignment="Bottom" Height="48" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Command="{Binding RemoveSelectedChartsCommand}" Cursor="Hand" Width="36" Margin="4,0,4,0" Height="36" Padding="5,5,5,5" IsEnabled="False" x:Name="Tool_DeleteCharts" >
                    <ui:FontIcon Foreground="#f0768b" Icon="{x:Static ui:SegoeFluentIcons.Delete}" ToolTip="删除" />
                </Button>
                <Button IsEnabled="False" Cursor="Hand" Width="36" Margin="4,0,4,0" ToolTip="编辑" Height="36" Padding="5,5,5,5" x:Name="Tool_EditChart">
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Edit}"/>
                </Button>
                <Button Command="{Binding FreezeChartsCommand}" IsEnabled="False" Cursor="Hand" Width="36" Margin="4,0,4,0" ToolTip="归档" Height="36" Padding="5,5,5,5" x:Name="Tool_ForzenCharts" >
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Package}" />
                </Button>
                <ui:AppBarSeparator/>
                <Button Cursor="Hand" Width="36" Margin="4,0,4,0" Height="36" ToolTip="新建" Padding="5,5,5,5" Style="{StaticResource {x:Static ui:ThemeKeys.AccentButtonStyleKey}}" x:Name="AddNewChart" Command="{Binding AddNewChartCommand}">
                    <!--<ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.AddBold}"/>-->
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.AddBold}" />
                </Button>
                <ui:AppBarSeparator/>
                <Button Cursor="Hand" Width="36" Margin="4,0,4,0" Height="36" ToolTip="保存" Command="{Binding SaveRecordsCommand}" Padding="5,5,5,5" >
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Save}" />
                </Button>
                <Button Cursor="Hand" Width="36" Margin="4,0,4,0" Height="36" ToolTip="导出" Command="{Binding ExportChartsCommand}" Padding="5,5,5,5" >
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Export}"  />
                </Button>
                <Button Cursor="Hand" Width="36" Margin="4,0,4,0" Height="36" ToolTip="..." Padding="5,5,5,5" >
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Cancel}"  />
                </Button>

            </StackPanel>
        </Grid>

        <!-- 添加 DraggablePanel 控件
        <Canvas>
            <windows:ExperimentPractise x:Name="DraggablePanel" 
                              Visibility="Visible"
                              Width="300"
                              Height="200"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top" 
                              Margin="10" />
        </Canvas> -->
        <!--消息中心-->
        <StackPanel Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="380" MaxHeight="500">
            <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Notifications}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:InfoBar 
                Title="{Binding Title}" 
                Message="{Binding Message}" 
                IsOpen="{Binding IsOpen}" 
                Severity="{Binding Severity}" />
                        <!-- 绑定Severity -->
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </Grid>

</ui:Page>
