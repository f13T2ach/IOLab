<ui:Page x:Class="IOLab.Pages.WorkshopPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:IOLab.Resources.Control"
      xmlns:cyct="clr-namespace:IOLab.Resources.Control.Cyber"
      xmlns:localcumstom="clr-namespace:IOLab.Resources.Control.Custom"
      xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
      
      xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
      d:DesignHeight="720" d:DesignWidth="1280"
      xmlns:lab="clr-namespace:IOLab.Resources.Control" xmlns:viewmodel="clr-namespace:IOLab.Pages.ViewModel" d:DataContext="{d:DesignInstance Type=viewmodel:WorkshopPageViewModel}"
      mc:Ignorable="d" 
      Title="创意工坊">
    <Grid>
        <ui:ScrollViewerEx>

            <Grid>
                
                

                <StackPanel Name="MainStack" Orientation="Vertical" Margin="40,20,40,40" VerticalAlignment="Top">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Network}" Margin="4"/>
                            <TextBlock HorizontalAlignment="Left" FontSize="25"></TextBlock>
                        </StackPanel>
                        <Grid HorizontalAlignment="Center">
                            <localcumstom:SearchComboBox Width="400"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            
                            <Button Cursor="Hand" Margin="4" ToolTip="上传" Height="36" Command="{Binding UploadCommand}" Style="{StaticResource {x:Static ui:ThemeKeys.AccentButtonStyleKey}}" >
                                <StackPanel Orientation="Horizontal">
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Upload}" />
                                    <TextBlock Margin="2,0,0,0"  Text="上传"/>
                                </StackPanel>
                            </Button>
                            <Button Cursor="Hand" Margin="4" ToolTip="我的" Height="36" Style="{StaticResource {x:Static ui:ThemeKeys.AccentButtonStyleKey}}" >
                                <StackPanel Orientation="Horizontal">
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.People}" />
                                    <TextBlock Margin="2,0,0,0" Text="我的"/>
                                </StackPanel>
                            </Button>
                            <Button Cursor="Hand" Width="36" Margin="4,0,4,0" Height="36" ToolTip="刷新" Command="{Binding RefreshCommand}" Padding="5,5,5,5" >
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Refresh}" />
                            </Button>
                        </StackPanel>

                    </Grid>

                    <ItemsControl ItemsSource="{Binding WorkshopContents}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="0" Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- 每个 WorkshopContent 控件的宽度相同，但高度根据内容调整 -->
                                <local:WorkshopContent Margin="10,5,10,5" DataContext="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>






                </StackPanel>

                <cyct:InfoBar Margin="0,10,0,0" Visibility="Hidden" x:Name="MyInfoBar"/>



            </Grid>



        </ui:ScrollViewerEx>

    </Grid>

</ui:Page>
