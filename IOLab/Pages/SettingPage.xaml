            <Border Style="{StaticResource Style_SectionBorderStyle}">
                <Grid VerticalAlignment="Center" Margin="0,10,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Light}" Grid.RowSpan="2" Margin="5,15,20,15"/>
                    <TextBlock x:Name="TextBlock_ThemeMode" Text="主题" Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                    <TextBlock x:Name="TextBlock_ThemeMode_Description" Text="调整主题色调（实验性效果）" Grid.Column="1" VerticalAlignment="Top" Grid.Row="1" Margin="0,2,20,5" Opacity="0.615" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="WrapWithOverflow"/>

                    <ComboBox x:Name="ComboBox_ThemeMode" Grid.Column="2" Grid.RowSpan="2" SelectedIndex="0" SelectionChanged="ComboBox_ThemeMode_SelectionChanged">
                        <ComboBoxItem x:Name="ComboBoxItem_ThemeMode_Default" Content="跟随系统"/>
                        <ComboBoxItem x:Name="ComboBoxItem_ThemeMode_Light" Content="浅色"/>
                        <ComboBoxItem x:Name="ComboBoxItem_ThemeMode_Dark" Content="深色"/>
                    </ComboBox>
                </Grid>
            </Border>

            <TextBlock Text="UI 设置" FontSize="16" Margin="0,20,0,4"/>
            <Border Style="{StaticResource Style_SectionBorderStyle}" Margin="0,0,0,4">
                <Grid VerticalAlignment="Center" Margin="0,10,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Color}" Grid.RowSpan="2" Margin="5,15,20,15"/>
                    <TextBlock Text="主题色" Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                    <TextBlock Grid.Column="1" VerticalAlignment="Top" Grid.Row="1" Margin="0,2,20,5" Opacity="0.615" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="WrapWithOverflow"><Run Text="点击色块可选预设颜色（微软蓝 一中红 樱粉 橘橙 柳绿） *尽量不要在图表绘制时改变颜色"/></TextBlock>

                    <ComboBox x:Name="ColorPickerComboBox" SelectionChanged="ColorPickerComboBox_SelectionChanged" Grid.Column="2" Grid.RowSpan="2">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Rectangle Width="20" Height="20" Fill="{Binding Color}" Margin="5"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                        <ComboBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ComboBox.ItemsPanel>
                    </ComboBox>
                </Grid>
            </Border>
            
            <TextBlock Grid.Column="1" VerticalAlignment="Top" Grid.Row="1" Margin="0,2,20,5" Opacity="0.615" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="WrapWithOverflow"><Run Text="基于 Fluent 风格的主题库，此应用程序既能提供完美的交互体验，亦能向下兼容至 Windows7 的设备"/></TextBlock>
            
            <TextBlock Text="高级设置" FontSize="16" Margin="0,20,0,4"/>
            <Border Style="{StaticResource Style_SectionBorderStyle}" Margin="0,0,0,4">
                <Grid VerticalAlignment="Center" Margin="0,10,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Globe}" Grid.RowSpan="2" Margin="5,15,20,15"/>
                    <TextBlock Text="服务器" Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                    <TextBlock Grid.Column="1" VerticalAlignment="Top" Grid.Row="1" Margin="0,2,20,5" Opacity="0.615" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="WrapWithOverflow"><Run Text="右方选区可以选择 IOLab 连接到的服务器，连接后 IOLab 会重新登录账户"/></TextBlock>

                    <ComboBox x:Name="ServerPickerBox" Grid.Column="2" Grid.RowSpan="2" SelectionChanged="ServerPickerBox_SelectionChanged">
                    </ComboBox>
                </Grid>
            </Border>
            <Border Style="{StaticResource Style_SectionBorderStyle}" Margin="0,0,0,4">
                <Grid VerticalAlignment="Center" Margin="0,10,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.ChinesePinyin}" Grid.RowSpan="2" Margin="5,15,20,15"/>
                    <TextBlock Text="使用「成龙化学实验室」作为程序标题" Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                    <TextBlock x:Name="EntryOfGame" MouseDown="EntryOfGame_MouseDown" Text="启用此项可使用中文标题，但这会使关于页面的「开发团队」条目消失" Grid.Column="1" VerticalAlignment="Top" Grid.Row="1" Margin="0,2,20,5" Opacity="0.615" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="WrapWithOverflow"/>

                    <ui:ToggleSwitch x:Name="ToggleSwitch_UseChineseName" Grid.Column="2" Grid.RowSpan="2" IsEnabled="False"/>
                </Grid>
            </Border>

            <TextBlock Text="实验性功能" FontSize="16" Margin="0,20,0,4"/>
            <Border Style="{StaticResource Style_SectionBorderStyle}" Margin="0,0,0,4">
                <Grid VerticalAlignment="Center" Margin="0,10,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Repair}" Grid.RowSpan="2" Margin="5,15,20,15"/>
                    <TextBlock Text="Engineer Mode" Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                    <TextBlock Text="Enable this mode allows you to use special functions" Grid.Column="1" VerticalAlignment="Top" Grid.Row="1" Margin="0,2,20,5" Opacity="0.615" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="WrapWithOverflow"/>

                    <ui:ToggleSwitch x:Name="ToggleSwitch_UseTongYiAI" Grid.Column="2" Grid.RowSpan="2" IsOn="False"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource Style_SectionBorderStyle}" Margin="0,0,0,4">
                <Grid VerticalAlignment="Center" Margin="0,10,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Error}" Grid.RowSpan="2" Margin="5,15,20,15"/>
                    <TextBlock Text="启用全局异常捕获功能" Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                    <TextBlock Text="此功能用于追踪异常，请勿关闭" Grid.Column="1" VerticalAlignment="Top" Grid.Row="1" Margin="0,2,20,5" Opacity="0.615" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="WrapWithOverflow"/>

                    <ui:ToggleSwitch x:Name="ToggleSwitch_UseGlobalExceptionCatch" Grid.Column="2" Grid.RowSpan="2" IsOn="True" IsEnabled="True" />
                </Grid>
            </Border>
        </StackPanel>
    </ui:ScrollViewerEx>
 </ui:Page>