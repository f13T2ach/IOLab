<ui:Page x:Class="IOLab.Pages.SettingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:IOLab.Pages"
      xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
      mc:Ignorable="d" 
         Unloaded="Page_Unloaded"
      d:DesignHeight="720" d:DesignWidth="1280"
      Title="设置">

    <FrameworkElement.Resources>
        <ResourceDictionary>

            <Style TargetType="Expander" BasedOn="{StaticResource {x:Static ui:ThemeKeys.ExpanderCardStyleKey}}">
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
            </Style>
            

            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Static ui:ThemeKeys.DefaultComboBoxStyleKey}}">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
            </Style>

            <Style TargetType="ui:FontIcon">
                <Setter Property="FontSize" Value="20"/>
            </Style>

            <Style TargetType="ui:ToggleSwitch">
                <Setter Property="MinWidth" Value="0"/>
            </Style>

        </ResourceDictionary>
    </FrameworkElement.Resources>
    <ui:ScrollViewerEx>
        <StackPanel MaxWidth="1280" Margin="40" VerticalAlignment="Top">
            <ui:AcrylicPanel CornerRadius="20" Margin="5,5,5,8" Height="160">
                <Grid Margin="12">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock x:Name="IONet_UserName" Text="未登录"  FontSize="40" FontWeight="Medium"/>
                        <StackPanel Orientation="Horizontal">
                            <Border CornerRadius="5" Width="40" Height="20" Margin="0,0,0,0" Background="{StaticResource {x:Static ui:ThemeKeys.AccentTextFillColorPrimaryBrushKey}}" >
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="EXP" FontWeight="Black"/>
                            </Border>
                            <TextBlock  x:Name="IONet_UserExperience" Margin="4,0,10,0" FontSize="14" VerticalAlignment="Center" Text="0" FontWeight="Black"/>
                            <TextBlock  x:Name="IONet_UserEmail" Text="若为登录失败，点「重新登录」可重试" FontSize="17" FontWeight="Light"/>
                            
                        </StackPanel>

                    </StackPanel>
                    <StackPanel Visibility="Visible" x:Name="UserPanel_Online" VerticalAlignment="Center"  HorizontalAlignment="Right" Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" Margin="5">
                            <Button Width="72" Height="72" Margin="5">
                                <StackPanel HorizontalAlignment="Center" Orientation="Vertical">
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.CheckboxComposite}"/>
                                    <TextBlock Text="签到" FontSize="12" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>
                            
                            <Button Width="72" Height="72" Margin="5">
                                <StackPanel HorizontalAlignment="Center" Orientation="Vertical">
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.ActionCenter}"/>
                                    <TextBlock Text="我的稿件" FontSize="12" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Width="72" Height="72" Margin="5">
                                <StackPanel HorizontalAlignment="Center" Orientation="Vertical">
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Edit}"/>
                                    <TextBlock Text="账号中心" FontSize="12" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="|" VerticalAlignment="Center" Opacity="0.7"/>
                            <Button Width="72" Height="72" Margin="5">
                                <StackPanel HorizontalAlignment="Center" Orientation="Vertical">
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Warning}"/>
                                    <TextBlock Text="内容检举" FontSize="12" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="CeaseSession" Click="CeaseSession_Click" Width="72" Height="72" Margin="5">
                                <StackPanel HorizontalAlignment="Center" Orientation="Vertical">
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.SignOut}"/>
                                    <TextBlock Text="登出" FontSize="12" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="|" VerticalAlignment="Center" Opacity="0.7"/>
                            <Button Width="72" Height="72" Margin="5">
                                <StackPanel HorizontalAlignment="Center" Orientation="Vertical">
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Globe}"/>
                                    <TextBlock Text="服务器" FontSize="12" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>


                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="Collapsed" x:Name="UserPanel_Offline" VerticalAlignment="Center"  HorizontalAlignment="Right" Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" Margin="5">

                            <Button Width="72" Height="72" Margin="5">
                                <StackPanel HorizontalAlignment="Center" Orientation="Vertical">
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Emoji}"/>
                                    <TextBlock Text="登录" FontSize="12" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Width="72" Height="72" Margin="5">
                                <StackPanel HorizontalAlignment="Center" Orientation="Vertical">
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Add}"/>
                                    <TextBlock Text="注册" FontSize="12" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="|" VerticalAlignment="Center" Opacity="0.7"/>
                            <Button Width="72" Height="72" Margin="5">
                                <StackPanel HorizontalAlignment="Center" Orientation="Vertical">
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Help}"/>
                                    <TextBlock Text="重新登录" FontSize="12" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>
                            


                        </StackPanel>
                    </StackPanel>

                </Grid>
            </ui:AcrylicPanel>
            <TextBlock Text="常规" FontSize="24" FontWeight="Bold" Margin="0,0,0,6"/>
            
            <!--
