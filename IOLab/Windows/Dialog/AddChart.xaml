<ui:ContentDialog
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    
    x:Class="IOLab.Windows.Dialog.AddChart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:IOLab.Windows.Dialog"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:viewmodel="clr-namespace:IOLab.Windows.Dialog.ViewModel" d:DataContext="{d:DesignInstance Type=viewmodel:AddChartViewModel}"
    mc:Ignorable="d"
    Title="新建监视器"
    PrimaryButtonText="提交变动"  
    SecondaryButtonText="取消"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    DefaultButton="Primary">

    <StackPanel Orientation="Vertical">
        <ui:ScrollViewerEx Margin="2" Orientation="Horizontal">
            <ItemsControl Height="64" ItemsSource="{Binding MyPorts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ToggleButton IsChecked="{Binding IsChecked, Mode=OneWay}" Checked="ToggleButton_Checked" Unchecked="ToggleButton_Checked" Content="{Binding PortId}" Margin="0, 0, 4, 0" Height="64" Width="64">
                        </ToggleButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ui:ScrollViewerEx>


        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
            <TextBlock Text="使用" Foreground="{StaticResource {x:Static ui:ThemeKeys.AccentTextFillColorPrimaryBrushKey}}"/>
            <TextBlock Text="{Binding SelectedPortID}" Foreground="{StaticResource {x:Static ui:ThemeKeys.AccentTextFillColorPrimaryBrushKey}}" Margin="2,0,2,0"/>
            <TextBlock Text="插口新建监视器" Foreground="{StaticResource {x:Static ui:ThemeKeys.AccentTextFillColorPrimaryBrushKey}}"/>
        </StackPanel>

        <Grid Margin="0,5,0,5">
            <TextBlock Text="采集方案" FontSize="15" Margin="6" HorizontalAlignment="Left"/>
            <ComboBox DisplayMemberPath="Name" SelectionChanged="ServiceComboBox_SelectionChanged" x:Name="ServiceComboBox" Height="32" Width="300" IsTextSearchEnabled = "True" IsEditable = "True" Margin="0,0,5,0" HorizontalAlignment="Right">
            </ComboBox>
        </Grid>
        <Grid Margin="0,5,0,5">
            <TextBlock Text="表名(留空自动生成)" FontSize="15" Margin="6" HorizontalAlignment="Left"/>
            <TextBox Height="32" Width="300" Margin="0,0,5,0" HorizontalAlignment="Right" x:Name="chartNameInput"/>
        </Grid>
        <Grid Margin="0,5,0,10">
            <TextBlock Text="表ID" FontSize="15" Margin="6" HorizontalAlignment="Left"/>
            <Slider x:Name="chartIDInput" Style="{StaticResource NumbericSlider}" FontSize="16" Value="1" Minimum="1" Maximum="99" ValueChanged="chartIDInput_ValueChanged" Height="32" Width="80" Margin="0,0,5,0" HorizontalAlignment="Right"/>
        </Grid>
        <TextBlock Text="正用于采样的插口不能被用于新建监视；后续可在新建图表中使用已配置的插口" Opacity="0.7"/>
        <TextBlock Text="最多支持 4 个插口同时绘图，绘图的插口过多会导致采样延迟" Opacity="0.7"/>
        <TextBlock Text="算法自动匹配最大值，已达99自己下调" Visibility="Hidden" Name="TipFor99"/>

    </StackPanel>


</ui:ContentDialog>