<ui:ContentDialog
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    
    x:Class="IOLab.Windows.Dialog.Universal.ExperimentCompleted"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:IOLab.Windows.Dialog.Universal"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="实验完成！"
    PrimaryButtonText="保存并解除"
    SecondaryButtonText="再做一次"
    CloseButtonText="仅解除实验"
    DefaultButton="Primary"
    >

    <ui:ContentDialog.Resources>
        <ui:Flyout x:Key="UnableSaveFlyout">
            <StackPanel>
                <TextBlock Text="请连接采集仪器后再试"/>
                <Button Content="了解"/>
            </StackPanel>
        </ui:Flyout>
    </ui:ContentDialog.Resources>
    <ui:ScrollViewerEx>

    <StackPanel VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <Grid>
            <TextBlock FontWeight="Bold" FontStyle="Italic" Opacity="0.3" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center">///EXPERIMENT FINISHED</TextBlock>
            <Image Source="pack://application:,,,/Resources/Images/Tiny/Rewards.png" Width="36"/>
        </Grid>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock FontWeight="Bold" FontStyle="Italic" Opacity="0.8">▌</TextBlock>
            <TextBlock FontWeight="Bold">探究光照对植物呼吸作用的影响</TextBlock>
        </StackPanel>
        <TextBlock Margin="5" HorizontalAlignment="Left" Width="360" TextWrapping="Wrap" Text="出色地完成！"/>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock FontWeight="Bold" FontStyle="Italic" Opacity="0.8">▌</TextBlock>
            <TextBlock FontWeight="Bold">AI实验总结</TextBlock>
        </StackPanel>
        <TextBox Margin="5" HorizontalAlignment="Left" x:Name="AISummary" Width="360" IsReadOnly="True" TextWrapping="Wrap" Text="请稍等，AI正在总结"/>

        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock FontWeight="Bold" FontStyle="Italic" Opacity="0.8">▌</TextBlock>
            <TextBlock FontWeight="Bold">我的进展</TextBlock>
        </StackPanel>
        <TextBlock Margin="5" Text="未选修练习册，选修后可用"/>
        <TextBlock Width="360" TextWrapping="Wrap" Text="「保存并解除」可以连带此实验一起保存到记录中；「再做一次」会为你保存此记录并重做实验；「仅解除实验」将仅关闭此窗口并解除实验，后续保存不会连带此实验保存至记录中。"/>
        </StackPanel>
        
    </ui:ScrollViewerEx>
</ui:ContentDialog>