<ui:ContentDialog
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    
    x:Class="IOLab.Windows.Dialog.Universal.OpenWebLink"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:IOLab.Windows.Dialog.Universal"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="打开 URL"
    PrimaryButtonText="继续"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    CloseButtonText="取消"
    DefaultButton="Primary"
    >



    <StackPanel VerticalAlignment="Stretch" HorizontalAlignment="Stretch">

        <TextBlock>即将打开此网页，请不要打开不信任的网址链接</TextBlock>
        <TextBlock HorizontalAlignment="Left" Foreground="{StaticResource {x:Static ui:ThemeKeys.AccentTextFillColorPrimaryBrushKey}}" x:Name="MyWebLink">Link</TextBlock>

    </StackPanel>
</ui:ContentDialog>