<ui:ContentDialog
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    
    x:Class="IOLab.Windows.Dialog.Register"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:IOLab.Windows.Dialog"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="注册"
    CloseButtonText="取消"
    PrimaryButtonText="继续"
    DefaultButton="Primary"
    >

    <ui:ContentDialog.Resources>
        <ui:Flyout x:Key="UnableSaveFlyout">
            <StackPanel>
                <TextBlock Text="无法保存修改"/>
                <Button Content="了解"/>
            </StackPanel>
        </ui:Flyout>
    </ui:ContentDialog.Resources>
    <Grid>
        <StackPanel x:Name="ConatinerA" Visibility="Visible" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <TextBlock Text="用户名" Width="64" Margin="5" VerticalAlignment="Center"/>
                <TextBox Margin="4" HorizontalAlignment="Center" Foreground="{StaticResource {x:Static ui:ThemeKeys.AccentTextFillColorPrimaryBrushKey}}" Width="320"></TextBox>
            </StackPanel>
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <TextBlock Text="邮箱" Width="64" Margin="5" VerticalAlignment="Center"/>
                <TextBox Margin="4" HorizontalAlignment="Center" Width="320"></TextBox>
            </StackPanel>
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <TextBlock Text="密码" Width="64" Margin="5" VerticalAlignment="Center"/>
                <TextBox Margin="4" HorizontalAlignment="Center" InputScope="Password" Width="320"></TextBox>
            </StackPanel>
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <TextBlock Text="重输密码" Width="64" Margin="5" VerticalAlignment="Center"/>
                <TextBox Margin="4" HorizontalAlignment="Center" InputScope="Password" Width="320"></TextBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="邮箱验证码" Width="64" Margin="5" VerticalAlignment="Center"/>
                <TextBox Margin="4" HorizontalAlignment="Center" InputScope="Number" Width="180"></TextBox>
                <Button Width="100" Margin="40,0,0,0" Content="发送验证码"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Visibility="Collapsed">
                <TextBlock Text="组织ID" Width="64" Margin="5" VerticalAlignment="Center"/>
                <TextBox Margin="4" HorizontalAlignment="Center" InputScope="Number" Width="180"></TextBox>
                <TextBlock Width="140" Margin="2,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" Opacity="0.7" Text="组织ID不是必填项，你的组织可以通过ID管理你"/>
            </StackPanel>
            <!--
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Margin="5">
                <Button Width="60" Height="60" Margin="5">
                    <StackPanel HorizontalAlignment="Center" Orientation="Vertical">
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Feedback}"/>
                        <TextBlock Text="忘记密码" FontSize="9" Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>
                <Button Width="60" Height="60" Margin="5">
                    <StackPanel HorizontalAlignment="Center" Orientation="Vertical">
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Add}"/>
                        <TextBlock Text="注册账号" FontSize="9" Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>
                <Button Width="60" Height="60" Margin="5">
                    <StackPanel HorizontalAlignment="Center" Orientation="Vertical">
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.QRCode}"/>
                        <TextBlock Text="授权微信" FontSize="9" Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>
                    
            </StackPanel>
            -->
            <TextBlock Foreground="Red" Text="[注意] 测试服务器不需要邮箱验证码，不要发"/>
            <Grid>
                <CheckBox Content="我已阅读并同意所有条款" HorizontalAlignment="Left"/>
                <Button Content="阅读所有条款" HorizontalAlignment="Right" />
            </Grid>
        </StackPanel>
    </Grid>
</ui:ContentDialog>