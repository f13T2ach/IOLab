<ui:ContentDialog
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    
    x:Class="IOLab.Windows.Dialog.Login"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:IOLab.Windows.Dialog"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="登录"
    PrimaryButtonText="关闭所有监视器"
    SecondaryButtonText="关闭窗口"
    DefaultButton="Secondary"
    >

    <ui:ContentDialog.Resources>
        <ui:Flyout x:Key="UnableSaveFlyout">
            <StackPanel>
                <TextBlock Text="无法保存修改"/>
                <Button Content="了解"/>
            </StackPanel>
        </ui:Flyout>
    </ui:ContentDialog.Resources>
    <Grid>
    <StackPanel x:Name="ConatinerA" Visibility="Visible" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
            <TextBlock Text="用户名"  Margin="5"/>
                <TextBox Margin="4" HorizontalAlignment="Center" Foreground="{StaticResource {x:Static ui:ThemeKeys.AccentTextFillColorPrimaryBrushKey}}" Width="320"></TextBox>
            </StackPanel>
        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Margin="5">
            <Button Width="60" Height="60" Margin="5">
                <StackPanel HorizontalAlignment="Center" Orientation="Vertical">
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Save}"/>
                    <TextBlock Text="保存" FontSize="12" Margin="0,5,0,0"/>
                </StackPanel>
            </Button>
            <Button Width="60" Height="60" Margin="5">
                <StackPanel HorizontalAlignment="Center" Orientation="Vertical">
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.SaveAs}"/>
                    <TextBlock Text="另存为" FontSize="12" Margin="0,5,0,0"/>
                </StackPanel>
            </Button>
            <Button Width="60" Height="60" Margin="5">
                <StackPanel HorizontalAlignment="Center" Orientation="Vertical">
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Export}"/>
                        <TextBlock Text="导出" FontSize="12" Margin="0,5,0,0"/>
                </StackPanel>
            </Button>
        </StackPanel>
         <CheckBox Content="只对选中的表操作"/>
        </StackPanel>
        <StackPanel x:Name="ConatinerB" Visibility="Hidden" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock TextAlignment="Center" Text="🖐" FontSize="20"/>
            <TextBlock x:Name="TipForFun" Text="" FontSize="14" Margin="0,5,0,0"/>
        </StackPanel>
    </Grid>
</ui:ContentDialog>