<ui:ContentDialog
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    
    x:Class="IOLab.Windows.ExperimentMaker.NewProject"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="创建新实验"
    CloseButtonText="取消"
    PrimaryButtonText="创建"
    DefaultButton="Primary"
    >

    <ui:ContentDialog.Resources>
        <ui:Flyout x:Key="UnableSaveFlyout">
            <StackPanel>
                <TextBlock Text="无法保存修改"/>
                <Button Content="了解"/>
            </StackPanel>
        </ui:Flyout>
    </ui:ContentDialog.Resources>
    <Grid>
        <StackPanel x:Name="ConatinerA" Visibility="Visible" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <TextBlock Text="实验名称" Width="64" Margin="5" VerticalAlignment="Center"/>
                <TextBox Name="UsernameInput" Margin="4" HorizontalAlignment="Center" Width="320"></TextBox>
            </StackPanel>
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <TextBlock Text="实验介绍" Width="64" Margin="5" VerticalAlignment="Center"/>
                <TextBox Name="PasswordInput" Margin="4" HorizontalAlignment="Center" InputScope="Password" Width="320"></TextBox>
            </StackPanel>
            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" Margin="5">
                <Button Margin="2" x:Name="ShowContentList" VerticalAlignment="Top" Cursor="Hand" IsEnabled="True" Foreground="#FF6699" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Help}"/>
                        <TextBlock Text="在 Bilibili 查看视频教程" Margin="4,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Text="目前只支持部分功能" Opacity="0.6"/>
        </StackPanel>
    </Grid>
</ui:ContentDialog>