<Window x:Class="IOLab.Windows.LabAI.LabAIChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="对话框" Height="650" Width="360">
    <Grid>
        <!-- 消息列表 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ListBox x:Name="MessagesListBox" Margin="0,0,0,36" HorizontalAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Border Background="{Binding BackgroundColor}" Opacity="0.5" BorderBrush="Black" BorderThickness="1" CornerRadius="5" Margin="5"/>
                            <TextBlock Text="{Binding Content}" VerticalAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" Padding="10"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>

        <!-- 用户输入框 -->
        <TextBox x:Name="UserInputTextBox" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="0,0,70,0" Height="30" KeyDown="UserInputTextBox_KeyDown"/>

        <!-- 发送按钮 -->
        <Button Content="发送" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="60" Height="30" Click="SendButton_Click"/>
    </Grid>
</Window>
